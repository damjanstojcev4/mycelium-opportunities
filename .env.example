# Copy to .env. Never commit credentials. The API expects a JDBC URL.
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/mycelium
DATABASE_USER=mycelium
DATABASE_PASSWORD=
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
MAIL_FROM=opportunities@example.com
NOTIFICATIONS_ENABLED=false
SOURCE_POLL_DELAY_MS=60000
TED_QUERY=buyer-country IN (MKD BGR GRC) SORT BY publication-date DESC
# Used only by optional local PostgreSQL service:
POSTGRES_DB=mycelium
POSTGRES_USER=mycelium
POSTGRES_PASSWORD=
